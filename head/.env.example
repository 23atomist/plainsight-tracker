# BEFORE the first `docker compose up`, run `mkdir -p data` as the operator
# user (uid 1000). Otherwise Docker creates ./data as root and the service
# cannot persist the pan reference.
#
# Copy to .env on the Orange Pi. Read by compose (variable substitution) and
# passed into the container (env_file).

# Host device facts (compose only)
HEAD_SERIAL_BY_ID=/dev/serial/by-id/usb-Raspberry_Pi_Pico_454741505A8814FA-if00
HEAD_I2C_BUS=3
DIALOUT_GID=20
I2C_GID=989
# Host-side published port (the container always listens on 8780).
# HEAD_HOST_PORT=8780

# Service settings, defaults shown. Uncomment to override.
# HEAD_SERIAL=/dev/ttyACM0
# HEAD_BAUD=115200
# HEAD_I2C_BUS is set above; unset would mean autodetect.
# HEAD_IMU_ADDRESS unset means autodetect (accepts 0x28 style).
# HEAD_IMU_ADDRESS=
# HEAD_AUTO_HOME=true
# HEAD_PAN_RESTORE=persisted
# HEAD_PAN_RESTORE_MAX_AGE_S=604800
# HEAD_REF_TILT_DEG=0.0
# HEAD_REF_TIMEOUT_S=120
# HEAD_IMU_HEADING_OFFSET_DEG=0.0
# HEAD_IMU_PITCH_OFFSET_DEG=0.0
# HEAD_IMU_TILT_AXIS=pitch
# HEAD_IMU_TILT_SIGN=1
# HEAD_JOG_DEADMAN_MS=500
# HEAD_TRACK_TIMEOUT_MS=1000
# HEAD_STREAM_MS=100
# HEAD_DATA_DIR=/data
# HEAD_LOG_LEVEL=INFO
