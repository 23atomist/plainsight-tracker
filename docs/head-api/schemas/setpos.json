{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plainsight.local/head-api/setpos.json",
  "title": "POST /api/setpos body",
  "description": "Declared current position per axis. Values must be finite.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "pan": {
      "type": "number"
    },
    "tilt": {
      "type": "number"
    },
    "zoom": {
      "type": "number"
    },
    "focus": {
      "type": "number"
    }
  }
}
