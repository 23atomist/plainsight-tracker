# Copy to .env and edit. Never commit .env.
PLAINSIGHT_DATA=/srv/plainsight
# The data tree must exist and be owned by uid 1000 BEFORE the first `up`
# (Node services run as uid 1000; mediamtx is pinned to 1000:1000):
#   sudo mkdir -p ${PLAINSIGHT_DATA}/{config,state,recordings,snapshots,adsb}
#   sudo chown -R 1000:1000 ${PLAINSIGHT_DATA}
# Without sudo: PLAINSIGHT_DATA=$HOME/plainsight-data and
#   mkdir -p ~/plainsight-data/{config,state,recordings,snapshots,adsb,chrony}
COMPOSE_PROFILES=adsb,gps,llm
# GPU host: uncomment to load compose.gpu.yaml on top of
# compose.yaml ONCE the NVIDIA Container Toolkit is installed (docs/DEPLOY.md
# "GPU"). On a host without the toolkit the stack will not start with it.
#COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# --- tracker ---
TB3_HEAD_URL=http://192.168.4.100:8780
TB3_ADSB_URL=http://127.0.0.1:8088/data/aircraft.json
# Local Ollama on the GPU (compose.gpu.yaml, profile llm). The model must
# leave VRAM for NVENC and the vision detector: ~7B q4 (about 5.5 GB at an
# 8k context) is the ceiling on an 11 GB card. Pull it once after `up`:
#   docker compose exec ollama ollama pull qwen2.5:7b-instruct
# Ollama Cloud is the fallback (https://ollama.com/v1/chat/completions,
# model gpt-oss:120b;
# put the key in TB3_LLM_API_KEY; see docs/DEPLOY.md). A blank KEY= counts as unset
# and the local server ignores the header either way.
TB3_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
TB3_LLM_MODEL=qwen2.5:7b-instruct
TB3_LLM_API_KEY=
# H.264 encoder for the camera ingest: nvenc on the GPU host (needs
# compose.gpu.yaml); x264 is the CPU fallback (720p at most on a small CPU).
TB3_CAMERA_ENCODER=nvenc
TB3_DASHBOARD_AUTH=false
TB3_MCP_TOKEN=

# --- camera / GPU (find yours with `ls /dev/v4l/by-id` and `getent group video render`) ---
CAMERA_DEVICE=/dev/v4l/by-id/usb-YOUR_CAMERA-video-index0
VIDEO_GID=44
RENDER_GID=992

# --- GPS (profile: gps) ---
GPS_DEVICE=/dev/serial/by-id/usb-YOUR_GPS-if00
# chrony (profile: gps). NMEA time arrives late by a device-specific amount;
# measure it with `docker compose exec chrony chronyc sourcestats` after an
# hour on the WAN and put the GPS line's offset here (seconds, usually
# 0.1-0.5), then tighten the delay to 0.2. Until then keep delay wide.
CHRONY_GPS_OFFSET=0.0
CHRONY_GPS_DELAY=0.5
# Who may ask this host for time (the LAN).
CHRONY_ALLOW=192.168.4.0/22

# --- ADS-B feeder (profile: adsb) ---
FEEDER_TZ=Etc/UTC
# Shown as your MLAT user name and the tar1090 page title.
FEEDER_NAME=my-feeder
# Antenna position (WGS84 degrees, metres above sea level). Aggregators use it
# for MLAT; it is public on their maps, so round it if you prefer.
FEEDER_LAT=
FEEDER_LONG=
FEEDER_ALT_M=
# Generate one with `cat /proc/sys/kernel/random/uuid`.
MULTIFEEDER_UUID=
# Optional: panorama id from heywhatsthat.com for tar1090 range rings.
FEEDER_HEYWHATSTHAT_ID=
FEEDER_HEYWHATSTHAT_ALTS=3000,10000,30000,40000
# ADALM-Pluto receiver. Expect less range than an RTL-SDR with a 1090 filter:
# an external LNA + 1090 MHz filter in front of the Pluto is the remedy (it has
# no bias-tee). If an RTL-SDR returns, drop readsb-pluto and set
# READSB_DEVICE_TYPE=rtlsdr on the adsb service again.
PLUTO_URI=usb:
PLUTO_GAIN=60

# --- optional InfluxDB stats output ---
INFLUX_URL=http://192.168.4.11:8181
INFLUX_TOKEN=
INFLUX_BUCKET=adsb
